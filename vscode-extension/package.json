{
  "name": "ybm-control-bridge",
  "displayName": "YBM Control Bridge",
  "description": "Companion VS Code bridge for YBM Control.",
  "version": "0.1.0",
  "icon": "images/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/iodriller/YBM.git"
  },
  "homepage": "https://github.com/iodriller/YBM#readme",
  "bugs": {
    "url": "https://github.com/iodriller/YBM/issues"
  },
  "keywords": [
    "agent",
    "automation",
    "local-first"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:agentControl.showStatus",
    "onCommand:agentControl.syncState",
    "onCommand:agentControl.createTerminal"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agentControl.showStatus",
        "title": "YBM Control: Show Status"
      },
      {
        "command": "agentControl.syncState",
        "title": "YBM Control: Sync State"
      },
      {
        "command": "agentControl.createTerminal",
        "title": "YBM Control: Create Terminal"
      }
    ],
    "configuration": {
      "title": "YBM Control Bridge",
      "properties": {
        "agentControl.bridgeUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8765",
          "description": "Local backend URL for the YBM Control bridge."
        },
        "agentControl.bridgeTokenEnv": {
          "type": "string",
          "default": "VSCODE_BRIDGE_TOKEN",
          "description": "Environment variable name that stores the YBM Control bridge token. The extension also checks the workspace .env file."
        },
        "agentControl.bridgeToken": {
          "type": "string",
          "default": "",
          "description": "Optional YBM Control bridge token override. Prefer using the workspace .env file or environment variable."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.0"
  }
}
