# Telegram
AGENT_CHANNELS__TELEGRAM__TOKEN_ENV=TELEGRAM_BOT_TOKEN
# TELEGRAM_BOT_TOKEN=

# Admin UI
AGENT_SERVER__ADMIN_ENABLED=true
AGENT_SERVER__ADMIN_TOKEN_ENV=AGENT_ADMIN_TOKEN
# AGENT_ADMIN_TOKEN=

# LLM provider example
AGENT_LLM__PROFILES__DEFAULT__API_KEY_ENV=OPENAI_API_KEY
# OPENAI_API_KEY=
# LOCAL_LLM_API_KEY=

# LocalDeploy (optional local OpenAI-compatible LLM server this stack can launch).
# Only needed if you run a local LocalDeploy checkout; otherwise point llm.profiles
# in config/config.yaml at whatever OpenAI-compatible endpoint you use.
# YBM_LOCALDEPLOY_ROOT=C:\path\to\LocalDeploy
